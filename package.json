{
  "name": "helping-hand",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "api:generate": "bun run --cwd apps/api openapi:generate && bun run --cwd packages/api-client generate",
    "api:check": "bun run api:generate && git diff --exit-code -- apps/api/openapi.json packages/api-client/src/generated.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@helping-hand/api",
    "dev:mobile": "turbo dev --filter=@helping-hand/mobile",
    "dev:web": "turbo dev --filter=@helping-hand/web",
    "deploy": "bun run --cwd apps/api deploy && bun run --cwd apps/web deploy",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "husky": "^9.1.7",
    "turbo": "^2.10.12"
  },
  "patchedDependencies": {
    "react-native@0.81.5": "patches/react-native@0.81.5.patch",
    "expo-speech@14.0.8": "patches/expo-speech@14.0.8.patch"
  }
}
