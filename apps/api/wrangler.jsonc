{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helping-hand",
  "compatibility_date": "2026-09-01",
  "main": "./src/index.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.helpinghand.chrisgo.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://api.helpinghand.chrisgo.dev",
    "TRUSTED_ORIGIN": "https://helpinghand.chrisgo.dev",
    "OPENROUTER_MODEL": "z-ai/glm-5.2:free"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "OPENROUTER_API_KEY"]
  },
  // Hourly bounded cleanup of expired enrollments and uncollected sessions.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    {
      "name": "MEMBER_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "GUEST_API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MEMBER_AI_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GUEST_AI_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "ENROLLMENT_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "database",
      "database_name": "helping-hand-db",
      "database_id": "f928870b-79f4-48bc-9205-02b7ec052ad0",
      "migrations_dir": "src/migrations"
    }
  ]
}
