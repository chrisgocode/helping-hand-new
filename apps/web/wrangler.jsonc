{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helping-hand-web",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "helpinghand.chrisgo.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
