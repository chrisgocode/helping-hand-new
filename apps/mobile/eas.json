{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.4.0",
      "environment": "development",
      "env": {
        "EAS_USE_CACHE": "1"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "bun": "1.4.0",
      "environment": "preview"
    },
    "capture": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_CAPTURE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "bun": "1.4.0",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
